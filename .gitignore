# Entornos virtuales
env/
venv/
venv311/
# Ignorar todo el contenido de data
data/input/*
data/output/*
data/archive/*

# Excepto el archivo .gitkeep
!data/input/.gitkeep
!data/output/.gitkeep
!data/archive/.gitkeep

# Archivos temporales de Jupyter y Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Configuración de VS Code
.vscode/

# Archivos de enviroment
.env

# Archivos de log
*.log
logs/*
!logs/.gitkeep